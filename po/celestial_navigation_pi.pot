msgid "\n"
msgstr ""

#: src/Sight.cpp:1344
#, c-format
msgid ""
"Input 1-sigma uncertainties   = LD %.3f'; Moon altitude %.3f'; %s altitude "
"%.3f'\n"
"Uncertainties are propagated, not applied as corrections.\n"
msgstr ""

#: src/Sight.cpp:1352
#, c-format
msgid ""
"Moon-altitude watch interval = %+.0f s\n"
"%s-altitude watch interval   = %+.0f s\n"
msgstr ""

#: src/Sight.cpp:1359
#, c-format
msgid "Observer motion               = COG %.1f%c true, SOG %.2f kn\n"
msgstr ""

#: src/Sight.cpp:1362
msgid "Observer motion between readings = not applied\n"
msgstr ""

#: src/Sight.cpp:1393
#, c-format
msgid ""
"\n"
"B. INSTRUMENT AND HORIZON CORRECTIONS AT %s\n"
"------------------------------------------------------------\n"
"Ic = IE / 60\n"
"Ic = %+.6f / 60 = %+.8f deg\n"
msgstr ""

#: src/Sight.cpp:1403
msgid ""
"Dip = 0 because an artificial horizon is selected.\n"
"Corrected altitude is halved after IE removal.\n"
msgstr ""

#: src/Sight.cpp:1407
#, c-format
msgid ""
"Dip = [0.4156 d + 1.856 h / d] / 60\n"
"Dip = [0.4156(%.6f) + 1.856(%.6f)/%.6f] / 60\n"
"Dip = %.8f deg\n"
msgstr ""

#: src/Sight.cpp:1415
#, c-format
msgid ""
"Dip = 1.758 sqrt(h) / 60\n"
"Dip = 1.758 sqrt(%.6f) / 60 = %.8f deg\n"
msgstr ""

#: src/Sight.cpp:1420
#, c-format
msgid ""
"Hlimb.m = Hs.m - Ic - Dip%s\n"
"Hlimb.m = %.8f - (%+.8f) - %.8f%s = %.8f deg\n"
"Hlimb.b = Hs.b - Ic - Dip%s\n"
"Hlimb.b = %.8f - (%+.8f) - %.8f%s = %.8f deg\n"
msgstr ""

#: src/Sight.cpp:1424 src/Sight.cpp:1427 src/Sight.cpp:1429 src/Sight.cpp:1432
msgid ", then / 2"
msgstr ""

#: src/Sight.cpp:1436
#, c-format
msgid ""
"\n"
"C. LIMB-TO-CENTRE REDUCTIONS\n"
"----------------------------\n"
"Moon SDgeo                    = %.8f deg\n"
"Moon HP                       = %.8f deg\n"
"Moon SDtopo = SDgeo[1 + sin(Hlimb.m) sin(HP)]\n"
"Moon SDtopo = %.8f[1 + sin(%.8f) sin(%.8f)] = %.8f deg\n"
"Moon altitude limb correction = %+.8f deg\n"
"%s SD                         = %.8f deg\n"
"%s altitude limb correction   = %+.8f deg\n"
"Ha.m = Hlimb.m + limb correction = %.8f deg\n"
"Ha.b = Hlimb.b + limb correction = %.8f deg\n"
"Moon distance correction       = %+.8f deg\n"
"%s distance correction         = %+.8f deg\n"
"LDo = LDs - Ic + Moon contact correction + body contact correction\n"
"LDo = %.8f - (%+.8f) + (%+.8f) + (%+.8f) = %.8f deg\n"
msgstr ""

#: src/Sight.cpp:1471
#, c-format
msgid ""
"\n"
"D. REFRACTION AND PARALLAX IN ALTITUDE\n"
"----------------------------------------\n"
"x = tan[Ha + 0.04848 / (tan(Ha) + 0.028)]\n"
"R = 0.267 P / [x(T + 273.15)] / 60\n"
"Moon: x = %.10f; R = 0.267(%.3f)/[%.10f(%.3f+273.15)]/60 = %.8f deg\n"
"%s: x = %.10f; R = 0.267(%.3f)/[%.10f(%.3f+273.15)]/60 = %.8f deg\n"
"Htopo.m = Ha.m - R.m = %.8f - %.8f = %.8f deg\n"
"Htopo.b = Ha.b - R.b = %.8f - %.8f = %.8f deg\n"
"Palt = asin[sin(HP) cos(Htopo)]\n"
"Moon: HP = %.8f; Palt = %.8f deg\n"
"%s: HP = %.8f; Palt = %.8f deg\n"
"Ho.m = Htopo.m + Palt.m = %.8f deg\n"
"Ho.b = Htopo.b + Palt.b = %.8f deg\n"
msgstr ""

#: src/Sight.cpp:1506
#, c-format
msgid ""
"\n"
"E. DIRECT SPHERICAL-TRIANGLE CLEARING\n"
"--------------------------------------\n"
"cos(DZ) = [cos(LDo) - sin(Ha.m)sin(Ha.b)] / [cos(Ha.m)cos(Ha.b)]\n"
"cos(DZ) = [cos(%.8f) - sin(%.8f)sin(%.8f)] / [cos(%.8f)cos(%.8f)]\n"
"cos(DZ) = %.12f\n"
"DZ = acos[cos(DZ)] = %.8f deg\n"
"\n"
"cos(LDc) = sin(Ho.m)sin(Ho.b) + cos(Ho.m)cos(Ho.b)cos(DZ)\n"
"cos(LDc) = sin(%.8f)sin(%.8f) + cos(%.8f)cos(%.8f)(%.12f)\n"
"cos(LDc) = %.12f\n"
"LDc = acos[cos(LDc)] = %.8f deg  (%s)\n"
msgstr ""

