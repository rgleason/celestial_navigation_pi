#: src/Sight.cpp:1814
#, c-format
msgid ""
"Moon altitude measurement (Hs) = %.4f%c = %s\n"
"\n"
msgstr ""

#: src/Sight.cpp:1836
#, c-format
msgid ""
"Dip Short Distance = %.4f m\n"
"Height Correction = 0.4156 * %.4f + 1.856 * %.5f / %.4f\n"
"Height Correction = %.4f%c = %s\n"
msgstr ""

#: src/Sight.cpp:1847
#, c-format
msgid ""
"Eye Height = %.4f m\n"
"Height Correction = 1.758%c * sqrt(%.4f) / 60.0\n"
"Height Correction = %.4f%c = %s\n"
msgstr ""

#: src/Sight.cpp:1859
#, c-format
msgid ""
"\n"
"Apparent Moon Altitude (Ha)\n"
"ApparentAltitudeMoon = Hs - IndexCorrection - EyeHeightCorrection\n"
"ApparentAltitudeMoon = %.4f%c - %.4f%c - %.4f%c\n"
"ApparentAltitudeMoon = %.4f%c = %s\n"
msgstr ""

#: src/Sight.cpp:1868
#, c-format
msgid ""
"\n"
"Artificial horizon\n"
"ApparentAltitudeMoon = ApparentAltitudeMoon / 2\n"
"ApparentAltitudeMoon = %.4f%c / 2 = %.4f%c\n"
msgstr ""

#: src/Sight.cpp:1881
#, c-format
msgid ""
"\n"
"Refraction Correction\n"
"x = tan(ApparentAltitudeMoon + 4.848e-2 / (tan(ApparentAltitudeMoon) + "
".028))\n"
"x = tan(%.4f + 4.848e-2 / (tan(%.4f) + .028))\n"
"x = %.4f\n"
msgstr ""

#: src/Sight.cpp:1889
#, c-format
msgid ""
"RefractionCorrectionMoon = .267%c * Pressure / (x * (Temperature + 273.15)) / "
"60.0\n"
"RefractionCorrectionMoon = .267%c * %.4f / (x * (%.4f + 273.15)) / 60.0\n"
"RefractionCorrectionMoon = %.4f%c = %s\n"
msgstr ""

#: src/Sight.cpp:1908
#, c-format
msgid ""
"\n"
"Moon selected, Limb Correction\n"
"SD = %.4f%c = %s\n"
"topoSD = SD * (1 + sin(ApparentAltitudeMoon) * sin(lunarHP))\n"
"topoSD = %.4f\n"
"lc = asin(topoSD)\n"
"lc = %.4f%c = %s\n"
msgstr ""

#: src/Sight.cpp:1927
#, c-format
msgid ""
"\n"
"LimbCorrectionMoon = %.4f%c = %s\n"
msgstr ""

#: src/Sight.cpp:1935
#, c-format
msgid ""
"\n"
"Corrected Altitude (Hc)\n"
"CorrectedAltitudeMoon = ApparentAltitudeMoon - RefractionCorrectionMoon + "
"LimbCorrectionMoon\n"
"CorrectedAltitudeMoon = %.4f%c - %.4f%c + %.4f%c\n"
"CorrectedAltitudeMoon = %.4f%c = %s\n"
msgstr ""

#: src/Sight.cpp:1952
#, c-format
msgid ""
"ParallaxCorrectionMoon = asin(sin(HP) * cos(CorrectedAltitude))\n"
"ParallaxCorrectionMoon = asin(sin(%.4f) * cos(%.4f))\n"
"ParallaxCorrectionMoon = %.4f%c = %s\n"
msgstr ""

#: src/Sight.cpp:1961
#, c-format
msgid ""
"\n"
"Observed Altitude (Ho)\n"
"ObservedAltitudeMoon = CorrectedAltitudeMoon + ParallaxCorrectionMoon\n"
"ObservedAltitudeMoon = %.4f%c + %.4f%c\n"
"ObservedAltitudeMoon = %.4f%c = %s\n"
msgstr ""

#: src/Sight.cpp:1972
#, c-format
msgid ""
"\n"
"\n"
"%s altitude measurement (Hs) = %.4f%c = %s\n"
msgstr ""

#: src/Sight.cpp:1988
#, c-format
msgid ""
"Artificial horizon\n"
"ApparentAltitude = ApparentAltitudeMoon / 2\n"
"ApparentAltitude = %.4f%c / 2 = %.4f%c"
msgstr ""

#: src/Sight.cpp:2001
#, c-format
msgid ""
"\n"
"Refraction Correction\n"
"x = tan(ApparentAltitude + 4.848e-2 / (tan(ApparentAltitude) + .028))\n"
"x = tan(%.4f + 4.848e-2 / (tan(%.4f) + .028))\n"
"x = %.4f\n"
msgstr ""

#: src/Sight.cpp:2046
#, c-format
msgid ""
"\n"
"Corrected Altitude\n"
"CorrectedAltitude = ApparentAltitude - RefractionCorrection + LimbCorrection\n"
"CorrectedAltitude = %.4f%c - %.4f%c - %.4f%c\n"
"CorrectedAltitude = %.4f%c = %s\n"
msgstr ""

#: src/Sight.cpp:2067
#, c-format
msgid ""
"\n"
"Star selected, parallax correction\n"
"HP = %.4f%c\n"
msgstr ""

#: src/Sight.cpp:2094
msgid ""
"\n"
"\n"
"Apparent Lunar Distance (LDo)\n"
msgstr ""

#: src/Sight.cpp:2098
#, c-format
msgid ""
"LDo = LDO.pc - IndexCorrection + LunarTopoSD + SunSD\n"
"LDo = %.4f%c - %.4f%c + %.4f%c + %.4f%c\n"
"LDo = %.4f%c = %s\n"
msgstr ""

#: src/Sight.cpp:2109
#, c-format
msgid ""
"LDo is NEAR\n"
"LDo = LDO.pc - IndexCorrection + LunarTopoSD\n"
"LDo = %.4f%c - %.4f%c + %.4f%c\n"
"LDo = %.4f%c = %s\n"
msgstr ""

#: src/Sight.cpp:2120
#, c-format
msgid ""
"LDo is FAR\n"
"LDo = LDO.pc - IndexCorrection - LunarTopoSD\n"
"LDo = %.4f%c - %.4f%c - %.4f%c\n"
"LDo = %.4f%c = %s\n"
msgstr ""

#: src/Sight.cpp:2137
#, c-format
msgid ""
"\n"
"DZ Angle\n"
"ha.m = ApparentAltitudeMoon + LimbCorrectionMoon\n"
"ha.m = %.4f + %.4f = %.4f\n"
"ha.b = ApparentAltitude + LimbCorrection\n"
"ha.b = %.4f + %.4f = %.4f\n"
"cos(LDo) = sin(ha.m) * sin(ha.b) + cos(ha.m) * cos(ha.b) * cos(DZ)\n"
"cos(DZ) = cos(LDo) / cos(ha.m) / cos(ha.b) - tan(ha.m) * tan(ha.b)\n"
"cos(DZ) = cos(%.4f) / cos(%.4f) / cos(%.4f) - tan(%.4f) * tan(%.4f)\n"
"cos(DZ) = %.4f\n"
"DZ = %.4f%c = %s\n"
msgstr ""

#: src/Sight.cpp:2158
#, c-format
msgid ""
"\n"
"Lunar Distance Cleared (LDc)\n"
"ho.m = ha.m + ParallaxCorrectionMoon - RefractionCorrectionMoon\n"
"ho.m = %.4f + %.4f - %.4f = %.4f\n"
"ho.b = ha.b + ParallaxCorrection - RefractionCorrection\n"
"ho.b = %.4f + %.4f - %.4f = %.4f\n"
"cos(LDc) = sin(ho.m) * sin(ho.b) + cos(ho.m) * cos(ho.b) * cos(DZ)\n"
"cos(LDc) = sin(%.4f) * sin(%.4f) + cos(%.4f) * cos(%.4f) * cos(%.4f)\n"
"cos(LDc) = %.4f\n"
"LDc = %.4f%c = %s\n"
"\n"
msgstr ""

#: src/Sight.cpp:2217
#, c-format
msgid ""
"Lunar Distance Cleared (LDc) prediction for %s\n"
"cos(LDc) = sin(dec.m) * sin(dec.b) + cos(dec.m) * cos(dec.b) * cos(Dgha)\n"
"cos(LDc) = sin(%.4f) * sin(%.4f) + cos(%.4f) * cos(%.4f) * cos(%.4f)\n"
"cos(LDc) = %.4f\n"
"LDc = %.4f%c = %s\n"
msgstr ""

#: src/Sight.cpp:2234
#, c-format
msgid ""
"\n"
"Lunar Distance Cleared (LDc) prediction for %s\n"
"cos(LDc) = sin(dec.m) * sin(dec.b) + cos(dec.m) * cos(dec.b) * cos(Dgha)\n"
"cos(LDc) = sin(%.4f) * sin(%.4f) + cos(%.4f) * cos(%.4f) * cos(%.4f)\n"
"cos(LDc) = %.4f\n"
"LDc = %.4f%c = %s\n"
msgstr ""

#: src/Sight.cpp:2247
#, c-format
msgid ""
"\n"
"Interpolating Lunar Distance Cleared to find out UTC\n"
"UTC = time.start + (LDc - LDc.start) * (time.end - time.start) / (LDc.end - "
"LDc.start)\n"
"UTC = %s + (%.4f - %.4f) * (%s - %s) / (%.4f - %.4f)\n"
"UTC = %s\n"
msgstr ""

