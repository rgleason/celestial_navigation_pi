msgstr ""

#: src/Sight.cpp:701
#, c-format
msgid ""
"Dip Short Distance = %.4f nm\n"
"Eye Height = %.4f m = %.4f ft\n"
"Height Correction = atan(Eye Height / (6076 * Dip Short Distance) + Dip Short "
"Distance / 8268)\n"
"Height Correction = atan(%.4f / (6076 * %.4f) + %.4f / 8268)\n"
"Height Correction = %.4f%c = %s\n"
msgstr ""

#: src/Sight.cpp:715
#, c-format
msgid ""
"Eye Height = %.4f m\n"
"Height Correction = (1.758 * sqrt(Eye Height)) / 60\n"
"Height Correction = 1.758%c * sqrt(%.4f) / 60.0\n"
"Height Correction = %.4f%c = %s\n"
msgstr ""

#: src/Sight.cpp:728 src/Sight.cpp:1979
#, c-format
msgid ""
"\n"
"Apparent Altitude (Ha)\n"
"ApparentAltitude = Hs - IndexCorrection - EyeHeightCorrection\n"
"ApparentAltitude = %.4f%c - %.4f%c - %.4f%c\n"
"ApparentAltitude = %.4f%c = %s\n"
msgstr ""

#: src/Sight.cpp:737
#, c-format
msgid ""
"\n"
"Artificial horizon\n"
"ApparentAltitude = ApparentAltitude / 2\n"
"ApparentAltitude = %.4f%c / 2 = %.4f%c\n"
msgstr ""

#: src/Sight.cpp:748
#, c-format
msgid ""
"\n"
"Apparent Altitude (Ha) > 90, assuming backsight\n"
"ApparentAltitude = 180%c - ApparentAltitude\n"
"ApparentAltitude = 180%c - %.4f%c = %.4f%c\n"
msgstr ""

#: src/Sight.cpp:768
#, c-format
msgid ""
"\n"
"Refraction Correction\n"
"x = tan(ApparentAltitude + 4.848e-2 / (tan(ApparentAltitude) + .028))\n"
"x = tan((%.4f + 4.848e-2) / (tan(%.4f) + .028))\n"
"x = %.4f\n"
msgstr ""

#: src/Sight.cpp:775 src/Sight.cpp:2008
#, c-format
msgid ""
"RefractionCorrection = .267%c * Pressure / (x * (Temperature + 273.15)) / "
"60.0\n"
"RefractionCorrection = .267%c * %.4f / (x * (%.4f + 273.15)) / 60.0\n"
"RefractionCorrection = %.4f%c = %s\n"
msgstr ""

#: src/Sight.cpp:793 src/Sight.cpp:2023
#, c-format
msgid ""
"\n"
"Sun selected, Limb Correction\n"
"ra = %.4f, lc = 0.266564/ra = %.4f%c = %s\n"
msgstr ""

#: src/Sight.cpp:810
#, c-format
msgid ""
"\n"
"Moon selected, Limb Correction\n"
"SD = %.4f%c = %s\n"
"topoSD = SD * (1 + sin(ApparentAltitude) * sin(HP))\n"
"topoSD = %.4f\n"
"lc = asin(topoSD)\n"
"lc = %.4f%c = %s\n"
msgstr ""

#: src/Sight.cpp:824 src/Sight.cpp:1921 src/Sight.cpp:2032
msgid "Upper Limb"
msgstr ""

#: src/Sight.cpp:827 src/Sight.cpp:1924 src/Sight.cpp:2035
msgid "Lower Limb"
msgstr ""

#: src/Sight.cpp:831 src/Sight.cpp:2039
#, c-format
msgid ""
"\n"
"LimbCorrection = %.4f%c = %s\n"
msgstr ""

#: src/Sight.cpp:838
#, c-format
msgid ""
"\n"
"Corrected Altitude (Hc)\n"
"CorrectedAltitude = ApparentAltitude - RefractionCorrection + LimbCorrection\n"
"CorrectedAltitude = %.4f%c - %.4f%c + %.4f%c\n"
"CorrectedAltitude = %.4f%c = %s\n"
msgstr ""

#: src/Sight.cpp:851 src/Sight.cpp:2060
#, c-format
msgid ""
"\n"
"Sun selected, parallax correction\n"
"rad = %.4f, HP = 0.002442/rad = %.4f%c = %s\n"
msgstr ""

#: src/Sight.cpp:858 src/Sight.cpp:1945
#, c-format
msgid ""
"\n"
"Moon selected, parallax correction\n"
"HP = %.4f%c = %s\n"
msgstr ""

#: src/Sight.cpp:865
#, c-format
msgid ""
"\n"
"Planet selected, parallax correction\n"
"HP = %.4f%c = %s\n"
msgstr ""

#: src/Sight.cpp:874 src/Sight.cpp:2076
#, c-format
msgid ""
"ParallaxCorrection = asin(sin(HP) * cos(CorrectedAltitude))\n"
"ParallaxCorrection = asin(sin(%.4f) * cos(%.4f))\n"
"ParallaxCorrection = %.4f%c = %s\n"
msgstr ""

#: src/Sight.cpp:883 src/Sight.cpp:2085
#, c-format
msgid ""
"\n"
"Observed Altitude (Ho)\n"
"ObservedAltitude = CorrectedAltitude + ParallaxCorrection\n"
"ObservedAltitude = %.4f%c + %.4f%c\n"
"ObservedAltitude = %.4f%c = %s\n"
msgstr ""

